# =====================================================================
# ClaimDesk — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres_dev_123

# ─── JWT Authentication ───────────────────────────────────────────────
# Must be at least 32 characters. Change before any deployment.
JWT_SECRET=claimdesk_jwt_secret_change_in_production_32chars

# ─── CORS ─────────────────────────────────────────────────────────────
# Frontend origin allowed by the backend
CORS_ORIGIN=http://localhost:5173

# ─── Frontend (Vite build-time variable) ──────────────────────────────
# Backend API base URL consumed by the React app
VITE_API_URL=http://localhost:4000

# ─── Service URLs (Bypassing Docker) ─
ML_SERVICE_URL=http://localhost:8000
DATABASE_URL="postgresql://neondb_owner:npg_TEzuPDZ5k4Fx@ep-wandering-leaf-b5gjvtc8-pooler.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_TEzuPDZ5k4Fx@ep-wandering-leaf-b5gjvtc8.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
